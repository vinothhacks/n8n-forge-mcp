{
  "schemaVersion": 1,
  "contractName": "n8n-public-api-v1-discover-and-openapi-matrix",
  "openapiVersion": "3.0.0",
  "targetBaselineVersion": "2.48.7",
  "legacyFloorVersion": "2.3.6",
  "sanitizedServerTemplate": "https://n8n.example.internal/api/v1",
  "authentication": {
    "headerName": "X-N8N-API-KEY",
    "originScoped": true,
    "followRedirects": false,
    "nativeMcpEndpointPath": "/mcp-server/http",
    "nativeMcpAuthScheme": "Bearer",
    "separateTokensMandatory": true
  },
  "rateLimitContract": {
    "introducedIn": "2.47.0",
    "enabledByDefault": false,
    "buckets": [
      "global_api_key_read",
      "global_api_key_write",
      "per_endpoint_read",
      "per_endpoint_write"
    ],
    "headers": [
      "Retry-After",
      "X-RateLimit-Limit",
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ]
  },
  "idempotencyContract": {
    "introducedIn": "2.45.0",
    "headerName": "Idempotency-Key",
    "retentionWindowHours": 12,
    "supportedMethods": ["POST"],
    "ignoredMethods": ["GET", "PUT", "PATCH", "DELETE"],
    "onTimeoutPolicy": "reconcile_before_retry_using_identical_key_and_canonical_body"
  },
  "verifiedEdgeCases": {
    "agentScopesWithoutEndpoints": {
      "advertisedScopes": [
        "agent:create",
        "agent:read",
        "agent:update",
        "agent:delete",
        "agent:list"
      ],
      "restResourcesExposedInDiscover": false,
      "openapiPathsPresent": false,
      "requiredCapabilityDecision": "unsupported",
      "diagnosticCode": "AGENT_ENDPOINTS_NOT_EXPOSED",
      "rationale": "n8n /api/v1/discover includes agent:* scopes in the scope catalog even when no /agents REST resource is exposed; n8n_agents must report unsupported unless /agents REST operations or Native MCP agent tools are explicitly advertised."
    },
    "publishVsActivateNegotiation": {
      "modernRoutesIntroducedIn": "2.33.0",
      "modernPublishPath": "/workflows/{id}/publish",
      "modernUnpublishPath": "/workflows/{id}/unpublish",
      "legacyActivatePath": "/workflows/{id}/activate",
      "legacyDeactivatePath": "/workflows/{id}/deactivate",
      "deprecationHeader": "Deprecation",
      "postWriteVerification": "must_verify_activeVersionId_on_readback"
    }
  },
